# ═══════════════════════════════════════════════════════════════
# Production environment template
# Copy to .env.production and fill in real values.
# NEVER commit .env.production to git.
# ═══════════════════════════════════════════════════════════════

# ───── App ─────
APP_NAME=Shopify Cart
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_LOG_JSON=true

# ───── API ─────
API_V1_PREFIX=/api/v1
# Comma-separated — replace with real frontend origins
API_CORS_ORIGINS=https://shop.example.com,https://admin.example.com

# ───── JWT (⚠️ MUST CHANGE) ─────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=REPLACE-WITH-64-BYTE-RANDOM-STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ───── MySQL ─────
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=shopify
MYSQL_PASSWORD=CHANGE-THIS-STRONG-PASSWORD
MYSQL_DATABASE=shopify_cart
MYSQL_ROOT_PASSWORD=CHANGE-THIS-EVEN-STRONGER

# ───── Kafka ─────
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_CLIENT_ID=shopify-cart
KAFKA_CONSUMER_GROUP=shopify-cart-consumers
KAFKA_ENABLED=true

# ───── MLflow ─────
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=shopify-category-classifier
MLFLOW_REGISTERED_MODEL_NAME=shopify-category-classifier

# ───── Model ─────
MODEL_STAGE=Production
MODEL_CONFIDENCE_THRESHOLD=0.70
MODEL_TOP_K=3

# ───── Data ─────
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed

# ───── Cart ─────
CART_MAX_ITEMS=100
CART_MAX_QUANTITY_PER_ITEM=50

# ───── HuggingFace (optional) ─────
HF_TOKEN=

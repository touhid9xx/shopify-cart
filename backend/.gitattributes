# ----------------------------------------------------------------------
# Normalize all text files to LF on commit
# ----------------------------------------------------------------------
* text=auto eol=lf

# PowerShell scripts keep CRLF (Windows-native)
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Windows-specific config files
*.ini text eol=crlf

# ----------------------------------------------------------------------
# Binary files — never touch line endings
# ----------------------------------------------------------------------
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary

# ML model artifacts
*.pt binary
*.pth binary
*.ckpt binary
*.onnx binary
*.safetensors binary

# ----------------------------------------------------------------------
# Lock files — treat as binary to avoid merge conflicts
# ----------------------------------------------------------------------
*.lock binary
*.sh text eol=lf

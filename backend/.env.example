# ────────────────────────────────────────────────────────────
# Backend environment — copy to .env and fill real values
# ────────────────────────────────────────────────────────────

# ─── App ───
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_LOG_JSON=false

# ─── API ───
API_PREFIX=/api/v1

# ─── JWT ───
JWT_SECRET_KEY=CHANGE_ME_use_a_long_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── MySQL ───
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=CHANGE_ME
MYSQL_DATABASE=shopify_cart

# ─── Kafka ───
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092

# ─── MLflow ───
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_MODEL_NAME=shopify-category-classifier

# ─── Model / ML ───
ML_ENABLED=false
MODEL_CONFIDENCE_THRESHOLD=0.75
MODEL_TOP_K=3

# ─── Data paths ───
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_UPLOADS_DIR=data/uploads

# ─── Cart / Orders ───
CART_MAX_ITEM_QUANTITY=999

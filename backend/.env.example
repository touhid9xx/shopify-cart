# ─── App ────────────────────────────────────────────────
APP_NAME=Shopify Cart
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_VERSION=0.1.0

# ─── API ────────────────────────────────────────────────
API_V1_PREFIX=/api/v1
API_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ─── JWT ────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── MySQL ──────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=shopify
MYSQL_PASSWORD=shopify
MYSQL_DATABASE=shopify_cart
MYSQL_ROOT_PASSWORD=rootpassword

# ─── Kafka ──────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=shopify-cart
KAFKA_CONSUMER_GROUP=shopify-cart-consumers
KAFKA_ENABLED=true

# ─── MLflow ─────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=shopify-category-classifier
MLFLOW_MODEL_NAME=shopify-category-classifier
MLFLOW_REGISTERED_MODEL_NAME=shopify-category-classifier

# ─── Model ──────────────────────────────────────────────
MODEL_PATH=models/category_classifier.pt
MODEL_NUM_CLASSES=10
MODEL_CONFIDENCE_THRESHOLD=0.75
MODEL_IMAGE_SIZE=224
MODEL_TOP_K=3
MODEL_STAGE=None

# ─── Data ───────────────────────────────────────────────
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_BATCH_SIZE=32
DATA_NUM_WORKERS=4

# ─── Cart ───────────────────────────────────────────────
CART_MAX_ITEMS=50
CART_MAX_QUANTITY_PER_ITEM=10

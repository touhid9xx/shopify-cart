# backend/.env.docker — container-internal overrides (committed)

# ─── App ────────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false

# ─── MySQL (container DNS) ──────────────────────────────
MYSQL_HOST=mysql
MYSQL_PORT=3306

# ─── Kafka (container DNS) ──────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_ENABLED=true

# ─── MLflow (container DNS) ─────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000
